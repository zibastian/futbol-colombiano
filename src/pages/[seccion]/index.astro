---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotaCard from '../../components/NotaCard.astro';
import Anuncio from '../../components/Anuncio.astro';
import TablaPosiciones from '../../components/TablaPosiciones.astro';
import TablaAnotadores from '../../components/TablaAnotadores.astro';
import TablaDescenso from '../../components/TablaDescenso.astro';
import LlaveFinal from '../../components/LlaveFinal.astro';
import { seccionDeNota } from '../../data/secciones';
import { TABLA_DEMO, tablaDemo } from '../../data/tabla-demo';
import { GRUPOS_DEMO, gruposDemo } from '../../data/grupos-demo';
import {
  ESTADISTICAS_DEMO, goleadoresLiga, asistenciasLiga, goleadoresTorneo,
  asistenciasTorneo, goleadoresCopa, asistenciasCopa, tablaDescenso
} from '../../data/estadisticas-demo';
import { tablaPosiciones } from '../../lib/apifootball';
import { TORNEOS } from '../../data/torneos';
import { faseDe, faseAlcanzada, NOMBRE_FASE, FASES_DEMO, cuadrangulares, FINAL_DEMO } from '../../data/fases';
import { COLUMNISTAS_GENERALES, COLUMNISTAS_DE_EQUIPO } from '../../data/columnistas';
import { EQUIPOS, escudoDe } from '../../data/equipos';
import { urlNota } from '../../lib/rutas';

export async function getStaticPaths() {
  const { SECCIONES } = await import('../../data/secciones');
  return SECCIONES.map((s) => ({ params: { seccion: s.slug }, props: { seccion: s } }));
}

const { seccion } = Astro.props;
const LIMITE = 18;

const todas = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const notas = todas.filter((n) => seccionDeNota(n.data) === seccion.slug);
const visibles = notas.slice(0, LIMITE);

// --- Datos deportivos de la sección ---
const torneo = TORNEOS.find((t) => t.slug === seccion.slug);
const real = torneo ? await tablaPosiciones(torneo.ligaId, torneo.season) : [];
const filasReales = real.map((f) => ({
  posicion: f.posicion, equipo: f.equipo, pj: f.jugados, g: f.ganados, e: f.empatados,
  p: f.perdidos, gf: f.golesFavor, gc: f.golesContra, dg: f.diferencia, pts: f.puntos
}));

const esLiga = seccion.formato === 'liga';
const esGrupos = seccion.formato === 'grupos';
const usarDemo = ESTADISTICAS_DEMO && !filasReales.length;

// Tabla: liga -> una sola; copa -> grupos
const tablaUnica = filasReales.length ? filasReales : esLiga && TABLA_DEMO && usarDemo ? tablaDemo : [];
const grupos = esGrupos && GRUPOS_DEMO && usarDemo ? gruposDemo : [];

// Goleadores y asistencias por competición
const anotadores: Record<string, { goles: any[]; asistencias: any[] }> = {
  'liga-betplay': { goles: goleadoresLiga, asistencias: asistenciasLiga },
  'torneo-betplay': { goles: goleadoresTorneo, asistencias: asistenciasTorneo },
  'copa-betplay': { goles: goleadoresCopa, asistencias: asistenciasCopa }
};
const stats = usarDemo ? anotadores[seccion.slug] : undefined;

// Tarjetas de rendimiento (colombianos en el exterior)
const fmtDia = (d: Date) => {
  const t = d.toLocaleDateString('es-CO', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'America/Bogota' });
  return t.charAt(0).toUpperCase() + t.slice(1).replace('.', '.');
};
const fichasExterior =
  seccion.slug === 'colombianos-en-el-exterior'
    ? Object.values(
        notas.reduce((acc: Record<string, any>, n) => {
          const e = n.data.exterior;
          if (e && !acc[e.jugador]) {
            acc[e.jugador] = { ...e, url: urlNota(n), dia: fmtDia(n.data.pubDate) };
          }
          return acc;
        }, {})
      ).slice(0, 6)
    : [];

// --- Fases del torneo ---
// Un torneo largo pasa por tres momentos y cada uno se lee distinto. La fase
// vigente va primero; las ya jugadas se conservan más abajo porque la gente
// sigue consultando el todos contra todos durante los cuadrangulares.
const esTorneoLargo = Boolean(torneo) && esLiga;
const fase = esTorneoLargo ? faseDe(seccion.slug) : 'todos-contra-todos';
const hayCuadrangulares = esTorneoLargo && FASES_DEMO && faseAlcanzada(seccion.slug, 'cuadrangulares');
const hayFinal = esTorneoLargo && FASES_DEMO && faseAlcanzada(seccion.slug, 'final');
const gruposFase = hayCuadrangulares ? cuadrangulares() : [];

const hayDatos = tablaUnica.length > 0 || grupos.length > 0 || gruposFase.length > 0;

// Las firmas de club se agrupan por equipo: son 41 y en una sola grilla plana
// no se encuentra nada. Cada club aparece una vez, con sus una o dos voces.
const firmasPorEquipo = EQUIPOS.map((eq) => ({
  equipo: eq,
  firmas: COLUMNISTAS_DE_EQUIPO.filter((c) => c.equipo === eq.slug)
})).filter((g) => g.firmas.length > 0);
---

<Base
  title={esLiga || esGrupos ? `${seccion.nombre}: tabla de posiciones, goleadores y noticias` : seccion.nombre}
  description={seccion.descripcion}
>
  <div class="banner-seccion">
    <picture>
      <source media="(max-width: 640px)" srcset={`/banners/${seccion.slug}-movil.svg`} />
      <img src={`/banners/${seccion.slug}.svg`} alt={seccion.nombre} />
    </picture>
  </div>
  <h1 class="seccion visualmente-oculto">{seccion.nombre}</h1>
  <p class="intro-seccion">{seccion.descripcion}</p>

  {usarDemo && (hayDatos || stats) && (
    <p class="aviso-demo">Datos de ejemplo para validar el diseño — aún no conectados en vivo.</p>
  )}

  {esTorneoLargo && (
    <p class="fase-actual">
      Fase actual: <strong>{NOMBRE_FASE[fase]}</strong>
    </p>
  )}

  {hayFinal && <LlaveFinal final={FINAL_DEMO} />}

  {gruposFase.length > 0 && (
    <>
      <h2 class="seccion">Cuadrangulares semifinales</h2>
      <p class="nota-tabla">
        Los ocho clasificados se reparten en dos grupos y juegan ida y vuelta.
        El líder de cada cuadrangular avanza a la final.
      </p>
      <div class="grilla-grupos">
        {gruposFase.map((g) => (
          <TablaPosiciones filas={g.filas} titulo={g.nombre} clasifican={1} compacta={true} />
        ))}
      </div>
    </>
  )}

  {tablaUnica.length > 0 && (
    <>
      <h2 class="seccion">{esTorneoLargo ? 'Todos contra todos' : 'Tabla de posiciones'}</h2>
      {esTorneoLargo && (
        <p class="nota-tabla">
          19 fechas. Los ocho primeros clasifican a los cuadrangulares semifinales.
        </p>
      )}
      <TablaPosiciones filas={tablaUnica} clasifican={8} />
    </>
  )}

  {grupos.length > 0 && (
    <>
      <h2 class="seccion">Fase de grupos</h2>
      <div class="grilla-grupos">
        {grupos.map((g) => <TablaPosiciones filas={g.filas} titulo={g.nombre} clasifican={2} compacta={true} />)}
      </div>
      <p class="nota-tabla">Los dos primeros de cada grupo avanzan a la siguiente fase.</p>
    </>
  )}

  {(tablaUnica.length > 0 || grupos.length > 0) && stats && <Anuncio formato="horizontal" />}

  {stats && (
    <>
      <h2 class="seccion">Goleadores y asistencias</h2>
      <div class="grilla-stats">
        <TablaAnotadores filas={stats.goles} titulo="Goleadores" unidad="Goles" />
        <TablaAnotadores filas={stats.asistencias} titulo="Asistencias" unidad="Asist." />
      </div>
    </>
  )}

  {seccion.descenso && usarDemo && stats && <Anuncio formato="horizontal" />}

  {seccion.descenso && usarDemo && (
    <>
      <h2 class="seccion">Tabla del descenso</h2>
      <p class="nota-tabla">Promedio de puntos por partido en los últimos tres años.</p>
      <TablaDescenso filas={tablaDescenso} />
    </>
  )}

  {
    fichasExterior.length > 0 && (
      <section class="tablero-exterior">
        <h2 class="seccion">Rendimiento reciente</h2>
        <div class="grilla-jugadores">
          {fichasExterior.map((j) => (
            <a class="ficha-jugador" href={j.url}>
              <span class="jugador-dia">{j.dia}</span>
              <span class="jugador-nombre">{j.jugador}</span>
              <span class="jugador-club">{j.club} · {j.pais}</span>
              <span class="jugador-stats">
                <span><strong>{j.minutos ?? '—'}</strong><i>Min</i></span>
                <span><strong>{j.goles ?? 0}</strong><i>Goles</i></span>
                <span><strong>{j.asistencias ?? 0}</strong><i>Asist.</i></span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    seccion.slug === 'opinion' && (
      <section class="firmas">
        <h2 class="seccion">Nuestros columnistas</h2>
        <div class="grilla-firmas">
          {COLUMNISTAS_GENERALES.map((c) => (
            <a class="firma" href={`/columnistas/${c.slug}`} style={`--acento:${c.color}`}>
              <span class="firma-avatar">{c.nombre.slice(0, 2).toUpperCase()}</span>
              <span class="firma-nombre">{c.nombre}</span>
              <span class="firma-linea">{c.linea}</span>
            </a>
          ))}
        </div>

        <h2 class="seccion firmas-club">Una voz por club</h2>
        <p class="nota-tabla">
          Cada equipo tiene su columnista. Los cinco de mayor hinchada llevan dos:
          una firma de tribuna y otra que analiza en frío, para que un mismo partido
          se pueda leer desde dos miradas que no siempre coinciden.
        </p>
        <div class="grilla-clubes">
          {firmasPorEquipo.map((g) => (
            <div class="club-firmas">
              <span class="club-nombre">
                {escudoDe(g.equipo, 64) && <img src={escudoDe(g.equipo, 64)} alt="" width="22" height="22" loading="lazy" />}
                {g.equipo.nombre}
              </span>
              {g.firmas.map((c) => (
                <a class="firma-mini" href={`/columnistas/${c.slug}`} style={`--acento:${c.color}`}>
                  {c.nombre}
                </a>
              ))}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <Anuncio formato="horizontal" />

  <h2 class="seccion">Últimas noticias</h2>
  {visibles.length === 0 && <p>Aún no hay notas en esta sección.</p>}
  <div class="grilla-notas">
    {visibles.map((n) => (
      <NotaCard
        url={urlNota(n)}
        title={n.data.title}
        description={n.data.description}
        tipo={n.data.tipo}
        cover={n.data.cover}
        coverAlt={n.data.coverAlt}
      />
    ))}
  </div>

  {notas.length > LIMITE && (
    <p class="ver-mas"><a href="/archivo/1">Ver todo el archivo de noticias →</a></p>
  )}
</Base>

<style>
  .fase-actual {
    display: inline-block; margin: -0.4rem 0 1.2rem; padding: 0.35rem 0.85rem;
    background: var(--azul); color: #fff; border-radius: 999px;
    font-family: var(--condensada); font-size: 0.95rem;
    text-transform: uppercase; letter-spacing: 0.6px;
  }
  .fase-actual strong { color: var(--amarillo); font-weight: 700; }

  .firmas-club { margin-top: 2rem; }
  .grilla-clubes {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.9rem;
  }
  .club-firmas {
    background: var(--papel); border: 1px solid var(--borde); border-radius: 8px; padding: 0.6rem 0.75rem;
  }
  .club-nombre {
    display: flex; align-items: center; gap: 0.4rem; font-family: var(--condensada);
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--gris); margin-bottom: 0.35rem;
  }
  .club-nombre img { width: 22px; height: 22px; object-fit: contain; }
  .firma-mini {
    display: block; font-family: var(--serif); font-weight: 700; font-size: 0.98rem;
    color: var(--tinta); border-left: 3px solid var(--acento); padding: 0.15rem 0 0.15rem 0.5rem;
    margin-top: 0.2rem;
  }
  .firma-mini:hover { text-decoration: none; color: var(--acento); }

  .banner-seccion { margin: 0 0 1rem; border-radius: 10px; overflow: hidden; }
  .banner-seccion img { width: 100%; height: auto; display: block; }
  .visualmente-oculto {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .intro-seccion { color: var(--gris); margin: 0 0 1.4rem; max-width: 720px; font-size: 1.02rem; }
  .aviso-demo {
    background: #fff8e1; border-left: 4px solid var(--amarillo);
    padding: 0.5rem 0.85rem; font-size: 0.85rem; color: #6b5900; margin: 0 0 1.2rem;
  }
  .nota-tabla { font-size: 0.82rem; color: var(--gris); text-align: center; margin: -0.5rem auto 0.8rem; }
  .ver-mas { margin-top: 1.6rem; font-family: var(--condensada); font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.5px; }
  .grilla-grupos { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.2rem; }
  .grilla-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.2rem; margin-bottom: 1.6rem; }

  .tablero-exterior { margin-bottom: 1.6rem; }
  .grilla-jugadores { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 0.9rem; }
  .ficha-jugador {
    display: block; background: var(--azul); border-radius: 10px; padding: 0.8rem 0.95rem;
    color: #fff; border-top: 4px solid var(--amarillo);
  }
  .ficha-jugador:hover { text-decoration: none; background: #143a75; }
  .jugador-dia {
    display: block; font-family: var(--condensada); font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 1px; color: var(--amarillo); margin-bottom: 0.15rem;
  }
  .jugador-nombre { display: block; font-family: var(--condensada); font-size: 1.3rem; font-weight: 700; line-height: 1.1; }
  .jugador-club { display: block; font-size: 0.78rem; color: #a9bcd8; margin-bottom: 0.6rem; }
  .jugador-stats { display: flex; gap: 0.9rem; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 0.5rem; }
  .jugador-stats strong { display: block; font-family: var(--condensada); font-size: 1.3rem; line-height: 1; color: var(--amarillo); }
  .jugador-stats i { font-style: normal; font-size: 0.63rem; text-transform: uppercase; letter-spacing: 0.5px; color: #a9bcd8; }

  .firmas { margin-bottom: 1.6rem; }
  .grilla-firmas { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }
  .firma {
    display: block; background: var(--papel); border: 1px solid var(--borde);
    border-top: 4px solid var(--acento); border-radius: 10px; padding: 0.9rem 1rem; color: var(--tinta);
  }
  .firma:hover { text-decoration: none; background: var(--fondo-suave); }
  .firma-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: 50%; background: var(--acento); color: #fff;
    font-family: var(--condensada); font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem;
  }
  .firma-nombre { display: block; font-family: var(--serif); font-weight: 700; font-size: 1.1rem; }
  .firma-linea { display: block; font-size: 0.85rem; color: var(--gris); line-height: 1.4; }
</style>
