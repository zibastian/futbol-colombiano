---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Anuncio from '../../components/Anuncio.astro';
import NotaCard from '../../components/NotaCard.astro';
import { SITE } from '../../config';
import { seccionDeNota, seccionPorSlug } from '../../data/secciones';
import { buscarEquipo, escudoDe } from '../../data/equipos';
import { columnistaPorNombre } from '../../data/columnistas';
import { slugify } from '../../lib/slug';
import { urlNota, slugDeArchivo } from '../../lib/rutas';

export async function getStaticPaths() {
  const { seccionDeNota } = await import('../../data/secciones');
  const notas = await getCollection('noticias', ({ data }) => !data.draft);
  return notas.map((nota) => ({
    params: { seccion: seccionDeNota(nota.data), slug: nota.id.replace(/\.md$/, '') },
    props: { nota, todas: notas }
  }));
}

const { nota, todas } = Astro.props;
const { Content } = await render(nota);
const d = nota.data;
const seccion = seccionPorSlug(seccionDeNota(d));
const columnista = columnistaPorNombre(d.autor);

const fmt = (date: Date) =>
  date.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Bogota' });

const tags = [
  ...d.equipos.map((nombre) => {
    const eq = buscarEquipo(nombre);
    return eq
      ? { nombre: eq.nombre, url: `/equipos/${eq.slug}`, escudo: escudoDe(eq, 64) }
      : { nombre, url: null, escudo: null };
  }),
  ...d.jugadores.map((nombre) => ({ nombre, url: `/jugadores/${slugify(nombre)}`, escudo: null }))
].filter((t) => t.url);

const relacionadas = todas
  .filter((n) => n.id !== nota.id && seccionDeNota(n.data) === seccion?.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.description,
  inLanguage: SITE.lang,
  mainEntityOfPage: canonicalURL,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  articleSection: seccion?.nombre,
  author: { '@type': d.autor === 'Redacción' ? 'Organization' : 'Person', name: d.autor },
  publisher: { '@id': `${SITE.url}#org` },
  ...(d.cover ? { image: [new URL(d.cover, Astro.site).href] } : {})
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Portada', item: SITE.url },
    ...(seccion ? [{ '@type': 'ListItem', position: 2, name: seccion.nombre, item: `${SITE.url}/${seccion.slug}` }] : []),
    { '@type': 'ListItem', position: 3, name: d.title, item: canonicalURL }
  ]
};
---

<Base title={d.title} description={d.description} image={d.cover} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <meta property="article:published_time" content={d.pubDate.toISOString()} />
    {d.updatedDate && <meta property="article:modified_time" content={d.updatedDate.toISOString()} />}
  </Fragment>

  <nav class="miga" aria-label="Ruta">
    <a href="/">Portada</a> <span>›</span> {seccion && <a href={`/${seccion.slug}`}>{seccion.nombre}</a>}
  </nav>

  <article class="nota">
    <h1>{d.title}</h1>
    <img class="cubierta-nota" src={d.cover || '/portada-default.svg'} alt={d.coverAlt || d.title} />
    <p class="bajada">{d.description}</p>
    <p class="fechas">
      Por {columnista ? <a href={`/columnistas/${columnista.slug}`}>{columnista.nombre}</a> : d.autor} ·
      Publicado el <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
      {d.updatedDate && (<> · Actualizado el <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></>)}
    </p>
    {d.fuente && (
      <p class="atribucion">
        Según reporta <strong>{d.fuente.nombre}</strong>
        {d.fuente.url && <> (<a href={d.fuente.url} rel="nofollow noopener" target="_blank">ver publicación original</a>)</>}.
        {['reporte', 'fichaje'].includes(d.tipo) && ' Información en desarrollo hasta confirmación oficial.'}
      </p>
    )}

    <div class="cuerpo-nota"><Content /></div>

    <Anuncio formato="in-article" />

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <a href={t.url} class={t.escudo ? 'tag-equipo' : ''}>
            {t.escudo && <img src={t.escudo} alt="" width="20" height="20" loading="lazy" />}
            {t.nombre}
          </a>
        ))}
      </div>
    )}
  </article>

  {
    relacionadas.length > 0 && (
      <section class="relacionadas">
        <h2 class="seccion">Más de {seccion?.nombre}</h2>
        <div class="grilla-notas">
          {relacionadas.map((n) => (
            <NotaCard
              url={urlNota(n)}
              title={n.data.title}
              description={n.data.description}
              tipo={n.data.tipo}
              cover={n.data.cover}
              coverAlt={n.data.coverAlt}
            />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .miga { max-width: 720px; margin: 0 auto 0.8rem; font-family: var(--condensada);
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--gris); }
  .miga a { color: var(--gris); }
  .miga a:hover { color: var(--azul); }
  .miga span { margin: 0 0.3rem; }
  .relacionadas { max-width: 1100px; margin: 2.5rem auto 0; }
</style>
