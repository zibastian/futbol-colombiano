---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotaCard from '../../components/NotaCard.astro';

// Páginas hub (fase 1.5): cada tag de equipo, torneo o jugador genera su página.
// Más adelante estas páginas se enriquecen con datos de la API (tabla, fixtures).

const slugify = (s: string) =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

export async function getStaticPaths() {
  const slugifyLocal = (s: string) =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

  // Equipos y torneos ya tienen su propia ficha: no se duplican como tag.
  let propios = new Set<string>();
  try {
    const mod = await import('../../data/escudos.json');
    for (const e of (mod.default || mod) as any[]) propios.add(e.slug);
  } catch {}
  const { TORNEOS } = await import('../../data/torneos');
  for (const t of TORNEOS) propios.add(t.slug);

  const notas = await getCollection('noticias', ({ data }) => !data.draft);
  const mapa = new Map<string, { nombre: string; notas: typeof notas }>();
  for (const nota of notas) {
    const tags = [...nota.data.equipos, ...nota.data.torneos, ...nota.data.jugadores];
    for (const t of tags) {
      const slug = slugifyLocal(t);
      if (propios.has(slug)) continue;
      if (!mapa.has(slug)) mapa.set(slug, { nombre: t, notas: [] });
      mapa.get(slug)!.notas.push(nota);
    }
  }
  return [...mapa.entries()].map(([slug, { nombre, notas }]) => ({
    params: { tag: slug },
    props: { nombre, notas }
  }));
}

const { nombre, notas } = Astro.props;
const ordenadas = notas.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={nombre} description={`Noticias y cobertura de ${nombre} en Fútbol Colombiano.`}>
  <h1 class="seccion">{nombre}</h1>
  <p>Todas las noticias sobre {nombre}.</p>
  <div class="grilla-notas">
    {
      ordenadas.map((nota) => (
        <NotaCard
          slug={nota.id.replace(/\.md$/, '')}
          title={nota.data.title}
          description={nota.data.description}
          tipo={nota.data.tipo}
          cover={nota.data.cover}
          coverAlt={nota.data.coverAlt}
        />
      ))
    }
  </div>
</Base>
