---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Anuncio from '../../components/Anuncio.astro';
import { SITE } from '../../config';
import { TORNEOS } from '../../data/torneos';

export async function getStaticPaths() {
  const notas = await getCollection('noticias', ({ data }) => !data.draft);
  return notas.map((nota) => ({
    params: { slug: nota.id.replace(/\.md$/, '') },
    props: { nota }
  }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);
const d = nota.data;

const fmt = (date: Date) =>
  date.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Bogota' });

const slugify = (s: string) =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// Los tags de equipo llevan a su ficha (/equipos), los de torneo a su página
// (/torneos) y el resto a la página de tag. Un solo destino por entidad: sin
// páginas duplicadas y todo el enlazado interno apunta a los hubs reales.
let escudos: any[] = [];
try {
  const mod = await import('../../data/escudos.json');
  escudos = (mod.default || mod) as any[];
} catch {
  escudos = [];
}
const buscarEquipo = (nombre: string) => {
  const s = slugify(nombre);
  return escudos.find((e) => e.slug === s) || escudos.find((e) => e.slug.includes(s) || s.includes(e.slug));
};

const tags = [
  ...d.equipos.map((nombre) => {
    const eq = buscarEquipo(nombre);
    return eq
      ? { nombre, url: `/equipos/${eq.slug}`, escudo: `/escudos/64/${eq.id}.png` }
      : { nombre, url: `/tags/${slugify(nombre)}`, escudo: null };
  }),
  ...d.torneos.map((nombre) => {
    const t = TORNEOS.find((x) => x.slug === slugify(nombre));
    return { nombre, url: t ? `/torneos/${t.slug}` : `/tags/${slugify(nombre)}`, escudo: null };
  }),
  ...d.jugadores.map((nombre) => ({ nombre, url: `/tags/${slugify(nombre)}`, escudo: null }))
];
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// JSON-LD NewsArticle — con datePublished y dateModified (señal SEO clave)
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.description,
  inLanguage: SITE.lang,
  mainEntityOfPage: canonicalURL,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate || d.pubDate).toISOString(),
  author: { '@type': d.autor === 'Redacción' ? 'Organization' : 'Person', name: d.autor },
  publisher: { '@id': `${SITE.url}#org` },
  ...(d.cover ? { image: [new URL(d.cover, Astro.site).href] } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {})
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Portada', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: d.title, item: canonicalURL }
  ]
};
---

<Base title={d.title} description={d.description} image={d.cover} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <meta property="article:published_time" content={d.pubDate.toISOString()} />
    {d.updatedDate && <meta property="article:modified_time" content={d.updatedDate.toISOString()} />}
  </Fragment>

  <article class="nota">
    <span class="kicker">{d.tipo}</span>
    <h1>{d.title}</h1>
    <p class="bajada">{d.description}</p>
    <p class="fechas">
      Por {d.autor} · Publicado el <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
      {d.updatedDate && (
        <> · Actualizado el <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></>
      )}
    </p>
    {d.cover && <img src={d.cover} alt={d.coverAlt || d.title} />}
    {d.fuente && (
      <p class="atribucion">
        Según reporta <strong>{d.fuente.nombre}</strong>
        {d.fuente.url && <> (<a href={d.fuente.url} rel="nofollow noopener" target="_blank">ver publicación original</a>)</>}.
        {['reporte', 'fichaje'].includes(d.tipo) && ' Información en desarrollo hasta confirmación oficial.'}
      </p>
    )}
    <div class="cuerpo-nota">
      <Content />
    </div>

    <Anuncio formato="in-article" />

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <a href={t.url} class={t.escudo ? 'tag-equipo' : ''}>
            {t.escudo && <img src={t.escudo} alt="" width="20" height="20" loading="lazy" />}
            {t.nombre}
          </a>
        ))}
      </div>
    )}
  </article>
</Base>
