---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotaCard from '../../components/NotaCard.astro';
import Anuncio from '../../components/Anuncio.astro';
import TablaPosiciones from '../../components/TablaPosiciones.astro';
import TablaAnotadores from '../../components/TablaAnotadores.astro';
import { EQUIPOS, buscarEquipo, escudoDe } from '../../data/equipos';
import { TABLA_DEMO, tablaDemo } from '../../data/tabla-demo';
import { GRUPOS_DEMO, gruposDemo } from '../../data/grupos-demo';
import {
  ESTADISTICAS_DEMO, goleadoresLiga, asistenciasLiga,
  goleadoresTorneo, asistenciasTorneo
} from '../../data/estadisticas-demo';
import { urlNota } from '../../lib/rutas';
import { TORNEOS } from '../../data/torneos';
import { datosDe } from '../../data/deportivos';

export async function getStaticPaths() {
  const { EQUIPOS } = await import('../../data/equipos');
  return EQUIPOS.map((e) => ({ params: { equipo: e.slug }, props: { equipo: e } }));
}

const { equipo } = Astro.props;
const escudo = escudoDe(equipo, 256);

const notas = (await getCollection('noticias', ({ data }) => !data.draft))
  .filter((n) => n.data.equipos.some((e) => buscarEquipo(e)?.slug === equipo.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 12);

// Tabla donde aparece el equipo, con su fila resaltada.
//
// Sale de la MISMA fuente que la página de la competición. Antes esta ficha
// leía solo los datos de ejemplo: un club recién ascendido —o uno nuevo, como
// Independiente Yumbo— aparecía con números inventados aunque la sección de su
// torneo ya mostrara los reales.
const suTorneo = TORNEOS.find(
  (t) => t.slug === (equipo.division === 'A' ? 'liga-betplay' : 'torneo-betplay')
);
const datos = suTorneo ? await datosDe(suTorneo.slug, suTorneo.ligaId, suTorneo.season) : null;

const aFila = (f: any) => ({
  posicion: f.posicion, equipo: f.equipo, pj: f.jugados, g: f.ganados, e: f.empatados,
  p: f.perdidos, gf: f.golesFavor, gc: f.golesContra, dg: f.diferencia, pts: f.puntos,
  logo: f.logo || undefined
});
const estaAca = (filas: any[]) =>
  filas.some((f) => f.equipoId === equipo.apiId || buscarEquipo(f.equipo)?.slug === equipo.slug);

let tabla: any[] = [];
let tituloTabla = '';
const grupoReal = (datos?.grupos ?? []).find((g) => g.filas.length && estaAca(g.filas));
if (grupoReal) {
  // Se prefiere la tabla vigente si el club también está ahí: es la que importa.
  const vigenteSirve = datos!.tabla.length > 0 && estaAca(datos!.tabla);
  const elegido = vigenteSirve
    ? { nombre: datos!.tablaNombre ?? '', filas: datos!.tabla }
    : grupoReal;
  tabla = elegido.filas.map(aFila);
  tituloTabla = [suTorneo?.nombre, elegido.nombre].filter(Boolean).join(' · ');
} else if (equipo.division === 'A' && TABLA_DEMO) {
  tabla = tablaDemo;
  tituloTabla = 'Liga BetPlay';
} else if (GRUPOS_DEMO) {
  const grupo = gruposDemo.find((g) => g.filas.some((f) => buscarEquipo(f.equipo)?.slug === equipo.slug));
  if (grupo) {
    tabla = grupo.filas;
    tituloTabla = `Torneo BetPlay · ${grupo.nombre}`;
  }
}

// Goleadores y asistentes SOLO de este equipo
const delEquipo = (lista: any[]) =>
  lista.filter((f) => buscarEquipo(f.equipo)?.slug === equipo.slug);
// Los goleadores del CLUB en TODAS las competiciones que juega, no el top 10
// del torneo filtrado: con el top casi ningún equipo tenía a nadie y la sección
// desaparecía. Y separados por competición, porque los goles de la Liga y los
// de la Copa no se suman: son certámenes distintos.
const porCompeticion = (
  await Promise.all(
    TORNEOS.map(async (t) => {
      const d = await datosDe(t.slug, t.ligaId, t.season);
      const propios = equipo.apiId ? d.porEquipo?.[String(equipo.apiId)] : undefined;
      return {
        competencia: t.nombre,
        slug: t.slug,
        goles: propios?.goleadores ?? [],
        asistencias: propios?.asistencias ?? []
      };
    })
  )
).filter((c) => c.goles.length > 0 || c.asistencias.length > 0);

const hayReales = porCompeticion.length > 0;
// Respaldo de ejemplo solo si no hay NADA real de este club.
const bloques = hayReales
  ? porCompeticion
  : ESTADISTICAS_DEMO && !grupoReal
    ? [
        {
          competencia: equipo.division === 'A' ? 'Liga BetPlay' : 'Torneo BetPlay',
          slug: equipo.division === 'A' ? 'liga-betplay' : 'torneo-betplay',
          goles: delEquipo(equipo.division === 'A' ? goleadoresLiga : goleadoresTorneo),
          asistencias: delEquipo(equipo.division === 'A' ? asistenciasLiga : asistenciasTorneo)
        }
      ].filter((b) => b.goles.length || b.asistencias.length)
    : [];
const datosSonDemo = !grupoReal && !hayReales;

const equipoLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: equipo.oficial,
  alternateName: equipo.nombre,
  sport: 'Soccer',
  ...(escudo ? { logo: escudo } : {}),
  ...(equipo.estadio ? { location: { '@type': 'Place', name: equipo.estadio, address: equipo.ciudad } } : {}),
  ...(equipo.fundacion ? { foundingDate: String(equipo.fundacion) } : {}),
  description: equipo.descripcion
};
---

<Base
  title={`${equipo.nombre}: noticias, plantilla y posición`}
  description={`${equipo.descripcion} Últimas noticias, resultados y posición de ${equipo.nombre} en el fútbol colombiano.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(equipoLd)} />
  </Fragment>

  <section class="ficha-cabecera">
    {escudo ? (
      <img class="escudo" src={escudo} alt={`Escudo de ${equipo.nombre}`} width="120" height="120" />
    ) : (
      <div class="escudo-vacio" aria-hidden="true"><span>{equipo.nombre.slice(0, 2).toUpperCase()}</span></div>
    )}
    <div class="ficha-info">
      <span class="kicker">{equipo.division === 'A' ? 'Liga BetPlay' : 'Torneo BetPlay'}</span>
      <h1>{equipo.nombre}</h1>
      <p class="oficial">{equipo.oficial}{equipo.apodo && <> · <em>{equipo.apodo}</em></>}</p>
      <p class="descripcion">{equipo.descripcion}</p>
      <dl class="datos-equipo">
        <div><dt>Ciudad</dt><dd>{equipo.ciudad}</dd></div>
        {equipo.estadio && <div><dt>Estadio</dt><dd>{equipo.estadio}</dd></div>}
        {equipo.fundacion && <div><dt>Fundación</dt><dd>{equipo.fundacion}</dd></div>}
        <div><dt>División</dt><dd>{equipo.division === 'A' ? 'Primera A' : 'Primera B'}</dd></div>
      </dl>
    </div>
  </section>

  <Anuncio formato="horizontal" />

  {tabla.length > 0 && (
    <section class="bloque-tabla">
      <h2 class="seccion">Posición en el torneo</h2>
      {datosSonDemo && (
        <p class="aviso-demo">Datos de ejemplo para validar el diseño — aún no conectados en vivo.</p>
      )}
      <TablaPosiciones filas={tabla} titulo={tituloTabla} destacar={equipo.slug} compacta={true} clasifican={equipo.division === 'A' ? 8 : 2} />
    </section>
  )}

  {bloques.length > 0 && (
    <section class="bloque-stats">
      <h2 class="seccion">Goleadores y asistencias del equipo</h2>
      {bloques.map((b) => (
        <>
          <h3 class="competencia-titulo"><a href={`/${b.slug}`}>{b.competencia}</a></h3>
          <div class="grilla-stats">
            {b.goles.length > 0 && (
              <TablaAnotadores filas={b.goles} titulo="Goleadores" unidad="Goles" mostrarEquipo={false} />
            )}
            {b.asistencias.length > 0 && (
              <TablaAnotadores filas={b.asistencias} titulo="Asistencias" unidad="Asist." mostrarEquipo={false} />
            )}
          </div>
        </>
      ))}
    </section>
  )}

  <Anuncio formato="horizontal" />

  <h2 class="seccion">Noticias de {equipo.nombre}</h2>
  {notas.length === 0 && <p>Aún no hay noticias de {equipo.nombre}. Pronto llegarán.</p>}
  <div class="grilla-notas">
    {notas.map((n) => (
      <NotaCard
        url={urlNota(n)}
        title={n.data.title}
        description={n.data.description}
        tipo={n.data.tipo}
        cover={n.data.cover}
        coverAlt={n.data.coverAlt}
      />
    ))}
  </div>
</Base>

<style>
  .ficha-cabecera {
    display: flex; gap: 1.6rem; align-items: flex-start; background: var(--papel);
    border: 1px solid var(--borde); border-radius: 10px; padding: 1.4rem 1.5rem;
    border-top: 5px solid var(--azul); margin-bottom: 1.8rem;
  }
  .escudo { width: 120px; height: 120px; object-fit: contain; flex-shrink: 0; }
  .escudo-vacio {
    width: 120px; height: 120px; border-radius: 50%; background: var(--fondo-suave);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    font-family: var(--condensada); font-size: 2.4rem; color: var(--azul); font-weight: 700;
  }
  .ficha-info h1 { font-family: var(--serif); font-size: 2rem; margin: 0.1rem 0 0.2rem; letter-spacing: -0.5px; }
  .oficial { margin: 0 0 0.6rem; color: var(--gris); font-size: 0.92rem; }
  .descripcion { margin: 0 0 1rem; font-size: 1.02rem; line-height: 1.6; max-width: 640px; }
  .datos-equipo { display: flex; flex-wrap: wrap; gap: 1.6rem; margin: 0; }
  .datos-equipo dt {
    font-family: var(--condensada); font-size: 0.78rem; text-transform: uppercase;
    letter-spacing: 0.8px; color: var(--gris-claro);
  }
  .datos-equipo dd { margin: 0; font-weight: 600; font-size: 0.98rem; }
  .bloque-tabla { margin-bottom: 1.2rem; }
  .bloque-stats { margin-bottom: 1.4rem; }
  .grilla-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.2rem; }
  .competencia-titulo {
    font-size: 0.95rem; margin: 1.2rem 0 0.6rem; text-transform: uppercase;
    letter-spacing: 0.04em; color: var(--tenue);
  }
  .competencia-titulo a { color: inherit; text-decoration: none; }
  .competencia-titulo a:hover { color: var(--acento); }

  .aviso-demo {
    background: #fff8e1; border-left: 4px solid var(--amarillo); padding: 0.5rem 0.85rem;
    font-size: 0.85rem; color: #6b5900; margin: 0 auto 0.9rem; max-width: 760px;
  }
  @media (max-width: 640px) {
    .ficha-cabecera { flex-direction: column; align-items: center; text-align: center; }
    .datos-equipo { justify-content: center; }
    .descripcion { text-align: left; }
  }
</style>
