---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NotaCard from '../components/NotaCard.astro';
import Anuncio from '../components/Anuncio.astro';
import { urlNota } from '../lib/rutas';

const etiquetas: Record<string, string> = {
  cronica: 'Crónica', fichaje: 'Fichajes', previa: 'Previa', agenda: 'Agenda',
  opinion: 'Opinión', reporte: 'Reporte', nota: 'Noticias'
};

const LIMITE_PORTADA = 13; // 1 principal + 3 laterales + 9 en grilla

const notas = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const principal = notas[0];
const laterales = notas.slice(1, 4);
const resto = notas.slice(4, LIMITE_PORTADA);
const hayMas = notas.length > LIMITE_PORTADA;
---

<Base>
  {
    principal && (
      <section class="portada">
        <article class="nota-principal">
          <a href={urlNota(principal)}>
            <img class="cubierta" src={principal.data.cover || '/portada-default.svg'} alt={principal.data.coverAlt || principal.data.title} />
          </a>
          <span class="kicker">{etiquetas[principal.data.tipo] || 'Noticias'}</span>
          <h2><a href={urlNota(principal)}>{principal.data.title}</a></h2>
          <p>{principal.data.description}</p>
        </article>

        <aside class="columna-lateral" aria-label="Últimas noticias">
          {laterales.map((nota) => (
            <div class="item-lateral">
              <span class="kicker">{etiquetas[nota.data.tipo] || 'Noticias'}</span>
              <h3><a href={urlNota(nota)}>{nota.data.title}</a></h3>
            </div>
          ))}
          <Anuncio formato="rectangulo" />
        </aside>
      </section>
    )
  }

  {
    resto.length > 0 && (
      <>
        <Anuncio formato="horizontal" />
        <h2 class="seccion">Más noticias</h2>
        <div class="grilla-notas">
          {resto.map((nota, i) => (
            <>
              <NotaCard
                url={urlNota(nota)}
                title={nota.data.title}
                description={nota.data.description}
                tipo={nota.data.tipo}
                cover={nota.data.cover}
                coverAlt={nota.data.coverAlt}
              />
              {i === 2 && <Anuncio formato="in-feed" />}
            </>
          ))}
        </div>
        {hayMas && <p class="ver-mas"><a href="/archivo/1">Ver todo el archivo de noticias →</a></p>}
      </>
    )
  }

  {notas.length === 0 && <p>Aún no hay noticias publicadas.</p>}
</Base>

<style>
  .ver-mas {
    margin-top: 1.6rem; font-family: var(--condensada); font-size: 1.05rem;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
</style>
