---
interface Props {
  url: string;
  title: string;
  description: string;
  tipo: string;
  cover?: string;
  coverAlt?: string;
}
const { url, title, description, tipo, cover, coverAlt } = Astro.props;
// Ninguna tarjeta queda sin imagen: si la nota no trae portada, se usa la genérica.
const imagen = cover || '/portada-default.svg';
const etiquetas: Record<string, string> = {
  cronica: 'Crónica',
  fichaje: 'Fichajes',
  previa: 'Previa',
  agenda: 'Agenda',
  opinion: 'Opinión',
  reporte: 'Reporte',
  nota: 'Noticias'
};
---

<article class="nota-card">
  <a href={url}><img src={imagen} alt={coverAlt || title} loading="lazy" /></a>
  <div class="cuerpo">
    <span class="kicker">{etiquetas[tipo] || 'Noticias'}</span>
    <h3><a href={url}>{title}</a></h3>
    <p>{description}</p>
  </div>
</article>
