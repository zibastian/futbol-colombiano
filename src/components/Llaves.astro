---
// Fase de eliminación directa: los cruces, ronda por ronda.
//
// POR QUÉ NO ALCANZA UNA TABLA
// En la fase final no hay puntos, hay llaves. Y el equipo eliminado desaparece
// de las tablas de la API, así que sin esto la ficha de un club que llegó a
// cuartos y perdió no puede decir dónde quedó: se queda muda.
//
// Cuando se filtra por un equipo (`destacarId`) se lee como su recorrido: las
// llaves que jugó, en orden, con el resultado de cada una.

import type { RondaLlave } from '../data/deportivos';

interface Props {
  rondas: RondaLlave[];
  /** apiId del club a resaltar. Si se pasa, solo salen sus llaves. */
  destacarId?: number | null;
  titulo?: string;
}
const { rondas, destacarId = null, titulo } = Astro.props;

const visibles = destacarId
  ? rondas
      .map((r) => ({
        ...r,
        partidos: r.partidos.filter(
          (p) => p.localId === destacarId || p.visitanteId === destacarId
        )
      }))
      .filter((r) => r.partidos.length > 0)
  : rondas.filter((r) => r.partidos.length > 0);

const TERMINADO = ['FT', 'AET', 'PEN'];

// Las comparaciones se resuelven acá: el compilador de Astro lee "<" como
// apertura de etiqueta si aparecen en el template.
const preparadas = visibles.map((r) => ({
  ...r,
  partidos: r.partidos.map((p) => {
    const jugado = Boolean(p.estado && TERMINADO.includes(p.estado));
    const gl = p.golesLocal ?? 0;
    const gv = p.golesVisitante ?? 0;
    const fecha = p.fecha
      ? new Date(p.fecha).toLocaleDateString('es-CO', {
          day: 'numeric', month: 'short', timeZone: 'America/Bogota'
        })
      : '';
    return {
      ...p,
      jugado,
      fecha,
      ganoLocal: jugado && gl > gv,
      ganoVisitante: jugado && gv > gl,
      marcador: jugado ? `${gl} - ${gv}` : 'vs'
    };
  })
}));
---

{preparadas.length > 0 && (
  <div class="llaves">
    {titulo && <h3 class="llaves-titulo">{titulo}</h3>}
    {preparadas.map((r) => (
      <div class="ronda">
        <h4 class="ronda-nombre">{r.ronda}</h4>
        <ul class="cruces">
          {r.partidos.map((p) => (
            <li class={p.jugado ? 'cruce' : 'cruce por-jugar'}>
              <span class={p.ganoLocal ? 'lado gano' : 'lado'}>
                {p.logoLocal && <img src={p.logoLocal} alt="" width="20" height="20" loading="lazy" />}
                <span class="nombre">{p.local}</span>
              </span>
              <span class="marcador">
                {p.marcador}
                {!p.jugado && p.fecha && <i>{p.fecha}</i>}
              </span>
              <span class={p.ganoVisitante ? 'lado derecha gano' : 'lado derecha'}>
                <span class="nombre">{p.visitante}</span>
                {p.logoVisitante && <img src={p.logoVisitante} alt="" width="20" height="20" loading="lazy" />}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}

<style>
  .llaves { margin: 0 0 1.4rem; }
  .llaves-titulo { font-size: 1rem; margin: 0 0 0.7rem; }

  .ronda { margin-bottom: 1.1rem; }
  .ronda-nombre {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--gris); margin: 0 0 0.45rem; font-weight: 700;
  }

  .cruces { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }

  .cruce {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: 0.6rem; padding: 0.55rem 0.7rem;
    border: 1px solid var(--borde); border-radius: 8px; background: #fff;
    font-size: 0.88rem;
  }
  .cruce.por-jugar { background: transparent; border-style: dashed; }

  .lado { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .lado.derecha { justify-content: flex-end; }
  .lado .nombre { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* El que pasó va en negrita: se lee la llave de un vistazo. */
  .lado.gano { font-weight: 700; }
  .lado:not(.gano) { color: var(--gris); }
  .lado img { width: 20px; height: 20px; object-fit: contain; flex: none; }

  .marcador {
    font-family: var(--condensada); font-weight: 700; white-space: nowrap;
    text-align: center; min-width: 3.4rem;
  }
  .marcador i { display: block; font-size: 0.7rem; font-weight: 400; font-style: normal; color: var(--gris); }

  @media (max-width: 520px) {
    .cruce { font-size: 0.82rem; padding: 0.5rem 0.55rem; gap: 0.4rem; }
    .lado img { width: 18px; height: 18px; }
  }
</style>
