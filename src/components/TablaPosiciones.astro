---
import { buscarEquipo, escudoDe } from '../data/equipos';

interface Fila {
  posicion: number; equipo: string; pj: number; g: number; e: number;
  p: number; gf: number; gc: number; dg: number; pts: number;
}
interface Props {
  filas: Fila[];
  titulo?: string;
  destacar?: string;      // slug del equipo a resaltar (ficha de equipo)
  clasifican?: number;    // cuántos puestos marcar como zona de clasificación
  compacta?: boolean;
}
const { filas, titulo, destacar, clasifican = 8, compacta = false } = Astro.props;
---

<div class={`tabla-bloque ${compacta ? "compacta" : ""}`}>
  {titulo && <h3 class="tabla-titulo">{titulo}</h3>}
  <div class="tabla-wrap">
    <table class="tabla-posiciones">
      <thead>
        <tr>
          <th>#</th><th class="equipo-col">Equipo</th><th>PJ</th>
          {!compacta && <><th>G</th><th>E</th><th>P</th><th>GF</th><th>GC</th></>}
          <th>DG</th><th>Pts</th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((f) => {
            const eq = buscarEquipo(f.equipo);
            const escudo = escudoDe(eq, 64);
            const url = eq ? `/equipos/${eq.slug}` : null;
            const esDestacado = eq && destacar && eq.slug === destacar;
            return (
              <tr class={esDestacado ? 'destacado' : ''}>
                <td class={f.posicion <= clasifican ? 'pos clasifica' : 'pos'}>{f.posicion}</td>
                <td class="equipo-col">
                  {url ? (
                    <a href={url}>
                      {escudo && <img src={escudo} alt="" width="22" height="22" loading="lazy" />}
                      <span>{eq!.nombre}</span>
                    </a>
                  ) : (
                    <span class="sin-ficha">{f.equipo}</span>
                  )}
                </td>
                <td>{f.pj}</td>
                {!compacta && <><td>{f.g}</td><td>{f.e}</td><td>{f.p}</td><td>{f.gf}</td><td>{f.gc}</td></>}
                <td>{f.dg > 0 ? `+${f.dg}` : f.dg}</td>
                <td class="pts">{f.pts}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .tabla-bloque { max-width: 760px; margin: 0 auto 1.4rem; }
  .tabla-titulo {
    font-family: var(--condensada); font-size: 1.1rem; text-transform: uppercase;
    letter-spacing: 0.8px; margin: 0 0 0.4rem; color: var(--azul);
  }
  .tabla-wrap { overflow-x: auto; border: 1px solid var(--borde); border-radius: 8px; }
  .tabla-posiciones { border-collapse: collapse; width: 100%; font-size: 0.88rem; min-width: 520px; }
  .compacta .tabla-posiciones { min-width: 0; font-size: 0.84rem; }
  .compacta .equipo-col { min-width: 0; }
  .compacta .tabla-posiciones th, .compacta .tabla-posiciones td { padding: 0.4rem 0.3rem; }
  .tabla-posiciones th, .tabla-posiciones td { padding: 0.45rem 0.5rem; text-align: center; }
  .tabla-posiciones thead th {
    background: var(--azul); color: #fff; font-family: var(--condensada);
    font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;
  }
  .tabla-posiciones tbody tr:nth-child(odd) { background: #fff; }
  .tabla-posiciones tbody tr:nth-child(even) { background: var(--fondo-suave); }
  .tabla-posiciones tbody tr.destacado { background: #fff6d6 !important; }
  .tabla-posiciones tbody tr.destacado td { font-weight: 700; }
  .equipo-col { text-align: left !important; min-width: 190px; }
  .equipo-col a { display: flex; align-items: center; gap: 0.5rem; color: var(--tinta); font-weight: 600; }
  .equipo-col img { width: 22px; height: 22px; object-fit: contain; }
  .sin-ficha { color: var(--gris); font-weight: 600; }
  .pos { font-family: var(--condensada); font-weight: 700; color: var(--gris); }
  .pos.clasifica { color: #fff; background: var(--azul); }
  .pts { font-weight: 700; }
</style>
