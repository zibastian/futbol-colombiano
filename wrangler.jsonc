{
  // Configuración explícita para Cloudflare Workers (assets estáticos).
  // Su existencia evita que el autoconfig de wrangler instale el adaptador
  // de Astro y convierta el sitio a modo servidor: aquí solo se sirven
  // los archivos ya generados en dist/. Sitio 100% estático, como debe ser.
  "name": "futbol-colombiano",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist"
  }
}
